.row.pb-1.has-border-top.mt-3.pt-3
    .col-md-12
        h3([textContent]='translate.trans("changelogs.title")')
    .col-md-12.mb-2
        p.mb-0([textContent]='translate.trans("changelogs.description")')
    .col-md-12
        .row
            .col-md-12.changelog-table-wrap
                table.table.table-striped.table-bordered.table-hover.table-sm.changelog-table
                    thead
                        tr
                            th([textContent]='translate.trans("changelogs.column_version")')
                            th([textContent]='translate.trans("changelogs.column_date")')
                            th([textContent]='translate.trans("changelogs.column_description")')
                    tbody
                        tr
                            td 1.0.2
                            td 2026-11-06
                            td
                                ul.mb-0.pl-3
                                    li Maintenance release.
                        tr
                            td 1.0.1
                            td 2026-11-06
                            td
                                ul.mb-0.pl-3
                                    li Maintenance release.
                        tr
                            td 1.0.0
                            td 2026-11-06
                            td
                                ul.mb-0.pl-3
                                    li Initial independent release of this plugin.
                                    li Syncs OpenSSH config together with Tabby settings.
                                    li Keeps machine-specific local profiles, such as WSL, on their own devices.
                                    li Excludes SSH entries that connect back to the current computer.
                                    li Normalizes SSH key paths across operating systems.
                                    li Creates local backups and conflict snapshots before applying cloud changes.
    .col-md-12.pt-3.text-right
        button.btn.btn-warning.flex-shrink-0.ml-3.mb-2((click)='openPluginPage()')
            i.fas.fa-fw.fa-link.mr-2
            span([textContent]='translate.trans("buttons.visit_plugin_page")')
